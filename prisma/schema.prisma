generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum PayoutStatus {
  NOT_REQUIRED
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum BookingNotificationType {
  CUSTOMER_PAYMENT_CONFIRMATION
  ASTROLOGER_NEW_BOOKING
}

enum BookingNotificationStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  FAILED
}

model Booking {
  id                  String        @id @default(cuid())
  name                String
  phone               String
  email               String
  service             String
  birthDetails        String?
  amount              Int           @default(50000)
  currency            String        @default("INR")
  status              BookingStatus @default(PENDING)
  razorpayOrderId     String        @unique
  razorpayPaymentId   String?       @unique
  paymentVerifiedAt   DateTime?

  platformShare       Int           @default(0)
  astrologerShare     Int           @default(0)
  payoutStatus        PayoutStatus  @default(NOT_REQUIRED)

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  payout               AstrologerPayout?
  notifications        BookingNotification[]

  @@index([email])
  @@index([status])
  @@index([payoutStatus])
  @@index([createdAt])
}

model BookingNotification {
  id             String                     @id @default(cuid())
  bookingId      String
  type           BookingNotificationType
  status         BookingNotificationStatus @default(PENDING)
  twilioSid      String?                    @unique
  attempts       Int                        @default(0)
  lastError      String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  booking        Booking                    @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, type])
  @@index([status])
  @@index([createdAt])
}

model AstrologerPayout {
  id              String       @id @default(cuid())
  bookingId       String       @unique
  booking         Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  astrologerName  String
  astrologerEmail String
  grossAmount     Int
  platformAmount  Int
  payoutAmount    Int
  status          PayoutStatus @default(PENDING)
  payoutId        String?
  reference       String?
  failureReason   String?
  notificationSentAt DateTime?
  createdAt       DateTime     @default(now())
  paidAt          DateTime?

  @@index([status])
  @@index([createdAt])
}

model AiPrediction {
  id           String   @id @default(cuid())
  email        String
  name         String?
  birthDate    String
  birthTime    String
  birthPlace   String
  question     String
  answer       String
  model        String
  createdAt    DateTime @default(now())

  @@index([email, createdAt])
}
