# Neon / PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=your_secret_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Human consultation revenue split (amounts are in paise for BOOKING_AMOUNT)
BOOKING_AMOUNT=50000
PLATFORM_SHARE_PERCENT=20
ASTROLOGER_SHARE_PERCENT=80

# Astrologer notification
ASTROLOGER_NAME=Your Astrologer Name
ASTROLOGER_EMAIL=astrologer@example.com
ASTROLOGER_WHATSAPP_NUMBER=919999999999

# Groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# Free AI predictions
AI_FREE_QUESTIONS=unlimited

# WhatsApp Cloud API
# Create a WhatsApp Business Platform app in Meta and use its Phone Number ID and access token.
WHATSAPP_GRAPH_API_VERSION=vXX.X
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_BOOKING_TEMPLATE_NAME=booking_confirmation
WHATSAPP_ASTROLOGER_TEMPLATE_NAME=astrologer_new_booking

# Email - Resend (optional; no longer used for booking confirmations)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL="Nakshatra Readings <your-verified-sender@example.com>"
