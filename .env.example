# Public production URL used by Google OAuth redirect
NEXT_PUBLIC_APP_URL=https://YOUR-STABLE-PRODUCTION-DOMAIN

# Google OAuth 2.0 Web application credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Random server-side secret, 32+ characters
AUTH_SECRET=replace-with-a-long-random-secret

# Comma-separated Google account email allowlists
DEVELOPER_EMAILS=developer@example.com
ASTROLOGER_EMAILS=astrologer@example.com

# Astrologer details used on booking confirmation and slot management
ASTROLOGER_NAME=Astrologer Name
ASTROLOGER_PHONE_NUMBER=+91XXXXXXXXXX
